# Dependencies
node_modules/

# Generated Glaze output and local agent context
.glaze/
.glaze-core
.glaze-core/
.glaze_memory/
.mcp.json
.icon-hash
tmp/

# Local visual brainstorming artifacts
.superpowers/
/.seer-standalone-renderer.lock/

# Build caches and logs
/build/
*.tsbuildinfo
*.log
*.profraw

# Local git worktrees
.worktrees/

# Generated Xcode project and native build/release outputs (the macOS app is
# scaffolded via `xcodegen generate`; only its source/config/tests are
# tracked, never the generated project or build products)
apps/macos/Seer/Seer.xcodeproj/
apps/macos/**/DerivedData/
DerivedData/
# Worktree-local derived data when xcodebuild is invoked with a relative
# `-derivedDataPath build/xcode-derived-data` from apps/macos/Seer itself
# (as opposed to the repo-root `/build/` above).
apps/macos/Seer/build/
build/macos/
# scripts/build-macos-app.sh's own fixed output locations (already covered
# by `/build/` above; listed explicitly so the local unsigned build's
# derived data and copied .app are never mistaken for tracked artifacts).
build/macos/derived-data/
build/macos/unsigned/
*.xcarchive
*.dmg
apps/macos/**/notarization/
apps/macos/**/release-staging/
apps/macos/**/*.notarization.log

# OS files
.DS_Store
Thumbs.db
